# Backend API origin used by the React app (no trailing slash, without /api).
# Default when unset: https://slyviee-klcn-diabetic-retinopathy.hf.space
# Set it to an empty value to call same-origin /api (Vite dev proxy to http://127.0.0.1:8000).
VITE_API_URL=https://slyviee-klcn-diabetic-retinopathy.hf.space

# Lite mode (in-browser student). Weights are not in git; default host is the public
# Hugging Face model repo slyviee/klcn-dr-student-lite. Override to self-host.
# VITE_LITE_MODEL_URL=https://huggingface.co/slyviee/klcn-dr-student-lite/resolve/main/student_effb4_twohead_448_fp32.onnx
# VITE_LITE_GATE_URL=https://huggingface.co/slyviee/klcn-dr-student-lite/resolve/main/fundus_gate.onnx
